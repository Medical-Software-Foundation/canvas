{
    "sdk_version": "0.1.4",
    "plugin_version": "0.1.11",
    "name": "failed_fax_dashboard",
    "description": "Dashboard listing faxes that failed across the practice: sent faxes that were not delivered and received faxes that arrived only in part. Shows each row's attempts and task, lets staff resend a note fax, reassign or comment on the row's task, or dismiss it, and creates a task for each new failure.",
    "components": {
        "applications": [
            {
                "class": "failed_fax_dashboard.applications.fax_dashboard_app:FailedFaxDashboardApp",
                "name": "Failed Faxes",
                "description": "Opens the failed-fax dashboard.",
                "scope": "global",
                "icon": "assets/failed-fax-dashboard-icon.png"
            }
        ],
        "handlers": [
            {
                "class": "failed_fax_dashboard.api.dashboard_api:FailedFaxDashboardAPI",
                "description": "Serves the dashboard page and its data, resend, task reassign and comment, saved settings, and dismiss endpoints to logged-in staff.",
                "data_access": {
                    "event": "",
                    "read": [
                        "Fax",
                        "NoteActionEvent",
                        "ReferralActionEvent",
                        "ImagingOrderActionEvent",
                        "LabOrderActionEvent",
                        "LetterActionEvent",
                        "IntegrationTaskActionEvent",
                        "Note",
                        "Referral",
                        "ImagingOrder",
                        "LabOrder",
                        "Letter",
                        "IntegrationTask",
                        "Patient",
                        "Staff",
                        "CanvasUser",
                        "Team",
                        "Task",
                        "TaskComment",
                        "ServiceProvider"
                    ],
                    "write": []
                }
            },
            {
                "class": "failed_fax_dashboard.handlers.fax_alert_cron:FaxAlertCron",
                "description": "Every 5 minutes, creates a task for each new failed fax, moves it to each new sender, and closes it once a later attempt is delivered.",
                "data_access": {
                    "event": "",
                    "read": [
                        "Fax",
                        "NoteActionEvent",
                        "ReferralActionEvent",
                        "ImagingOrderActionEvent",
                        "LabOrderActionEvent",
                        "LetterActionEvent",
                        "IntegrationTaskActionEvent",
                        "Note",
                        "Referral",
                        "ImagingOrder",
                        "LabOrder",
                        "Letter",
                        "IntegrationTask",
                        "Patient",
                        "Staff",
                        "CanvasUser",
                        "Team",
                        "Task",
                        "TaskComment",
                        "ServiceProvider"
                    ],
                    "write": []
                }
            }
        ]
    },
    "variables": [
        {
            "name": "FAX_DASHBOARD_STAFF_IDS",
            "default": ""
        },
        {
            "name": "FAILED_FAX_FALLBACK_TEAM",
            "default": ""
        },
        {
            "name": "RECEIVED_FAX_TASK_TEAM",
            "default": ""
        },
        {
            "name": "PROVIDER_ROLES",
            "default": ""
        },
        {
            "name": "PROVIDER_FAX_TASK_ROLE",
            "default": ""
        },
        {
            "name": "namespace_read_write_access_key",
            "sensitive": true
        }
    ],
    "custom_data": {
        "namespace": "canvas_medical__failed_fax_dashboard",
        "access": "read_write"
    },
    "tags": {},
    "references": [],
    "license": "MIT",
    "diagram": false,
    "readme": "README.md"
}
