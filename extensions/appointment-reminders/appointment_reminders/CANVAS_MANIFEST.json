{
  "sdk_version": "0.95.0",
  "plugin_version": "0.15.1",
  "name": "appointment_reminders",
  "description": "Appointment reminders and confirmations (SMS + email) with per-business-line customization, optional locked message copy, and two-way Y/N confirmation.",
  "components": {
    "protocols": [
      {
        "class": "appointment_reminders.handlers.event_handler:AppointmentEventHandler",
        "description": "Sends instant notifications on appointment events",
        "data_access": {
          "event": "",
          "read": [
            "v1.Patient",
            "v1.Appointment",
            "v1.PracticeLocation",
            "v1.NoteType",
            "v1.Organization",
            "v1.BusinessLine"
          ],
          "write": [
            "v1.Appointment"
          ]
        }
      },
      {
        "class": "appointment_reminders.handlers.reminder_scheduler:ReminderScheduler",
        "description": "Cron task that checks for upcoming booked appointments needing reminders and telehealth join notifications",
        "data_access": {
          "event": "",
          "read": [
            "v1.Patient",
            "v1.Appointment",
            "v1.PracticeLocation",
            "v1.NoteType",
            "v1.Staff",
            "v1.Organization",
            "v1.BusinessLine"
          ],
          "write": [
            "v1.Appointment"
          ]
        }
      },
      {
        "class": "appointment_reminders.handlers.notification_api:NotificationAPI",
        "description": "API endpoints for admin configuration and notification history",
        "data_access": {
          "event": "",
          "read": [
            "v1.NoteType",
            "v1.Note",
            "v1.Patient",
            "v1.Appointment",
            "v1.Staff",
            "v1.StaffRole",
            "v1.Team",
            "v1.Organization",
            "v1.PracticeLocation",
            "v1.BusinessLine"
          ],
          "write": [
            "v1.Appointment"
          ]
        }
      },
      {
        "class": "appointment_reminders.handlers.timeline_filter:TimelineMessageFilter",
        "description": "Hides message notes from the patient timeline",
        "data_access": {
          "event": "",
          "read": [
            "v1.NoteType"
          ],
          "write": []
        }
      },
      {
        "class": "appointment_reminders.handlers.twilio_inbound_api:TwilioInboundAPI",
        "description": "Twilio-signature-gated webhook for inbound patient SMS: structured Y/N confirms/declines an appointment, mirrors STOP/START consent onto the patient's phone, and opens follow-up tasks",
        "data_access": {
          "event": "",
          "read": [
            "v1.Patient",
            "v1.Appointment",
            "v1.Team"
          ],
          "write": [
            "v1.Appointment",
            "v1.Task",
            "v1.Patient"
          ]
        }
      }
    ],
    "applications": [
      {
        "class": "appointment_reminders.handlers.admin_app:NotifyAdminApp",
        "name": "Appointment Reminders",
        "description": "Configure appointment reminder campaigns and view message history",
        "icon": "assets/admin-icon.png",
        "scope": "provider_menu_item",
        "menu_position": "top",
        "menu_order": 100
      },
      {
        "class": "appointment_reminders.handlers.patient_app:NotifyPatientApp",
        "name": "Appointment Reminders",
        "description": "Appointment reminder history for this patient",
        "icon": "assets/patient-icon.png",
        "scope": "patient_specific",
        "show_in_panel": true,
        "panel_priority": 1
      }
    ],
    "commands": [],
    "content": [],
    "effects": [],
    "views": []
  },
  "variables": [
    {"name": "namespace_read_write_access_key", "sensitive": true},
    {"name": "twilio-account-sid", "sensitive": true},
    {"name": "twilio-auth-token", "sensitive": true},
    {"name": "twilio-api-key-sid", "sensitive": true},
    {"name": "twilio-api-key-secret", "sensitive": true},
    {"name": "twilio-phone-number", "sensitive": false},
    {"name": "twilio-inbound-webhook-url", "sensitive": false},
    {"name": "sendgrid-api-key", "sensitive": true},
    {"name": "sendgrid-from-email", "sensitive": false},
    {"name": "LOCK_MESSAGE_TEMPLATES", "sensitive": false},
    {"name": "ADMIN_ROLE_NAMES", "sensitive": false}
  ],
  "custom_data": {
    "namespace": "canvas__appointment_reminders",
    "access": "read_write"
  },
  "tags": {},
  "references": [],
  "license": "MIT",
  "diagram": false,
  "readme": "../README.md"
}
